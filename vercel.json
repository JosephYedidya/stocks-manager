{
    "version": 2,
    "builds": [
      {
        "src": "package.json",
        "use": "@vercel/static-build",
        "config": {
          "installCommand": "npm install && npm install vite --save-dev",
          "buildCommand": "npx vite build",
          "outputDirectory": "dist"
        }
      }
    ],
    "settings": {
      "nodeVersion": "18.x"
    }
  }